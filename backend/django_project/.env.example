# =============================================================================
# FileProcessor Pro — Backend Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (leave empty to use SQLite in development)
# ---------------------------------------------------------------------------
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=fileprocessor
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to False in production to use async Celery workers
CELERY_TASK_ALWAYS_EAGER=True

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins (used when DEBUG=False)
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Get this after running: stripe listen --forward-to localhost:8000/api/subscriptions/webhook/
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Frontend URLs (used in Stripe Checkout redirect)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Or override individually:
# STRIPE_SUCCESS_URL=http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
